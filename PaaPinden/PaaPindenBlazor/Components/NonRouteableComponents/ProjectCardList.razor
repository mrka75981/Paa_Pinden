@if (Projects != null)
{
    <div class="row">
        @foreach (Project project in Projects)
        {
            <ProjectCard Project="project"/>
        }
    </div>
    <div class="row">
        <div class="col-sm-5" />
        <div class="col-sm-2 card"><NavLink class="nav-link" href="@($"projects/create")">+</NavLink></div>
        <div class="col-sm-5" />
    </div>
}

@code {
    [Parameter]
    public List<Project>? Projects { get; set; }
}
