@inject IFileModelService _fileModelService
@inject IPaaPindenAPIService _paaPindenAPIService
@inject NavigationManager _navigationManager

@if (Project != null)
{
    <div class="col-2 card">
        <NavLink class="nav-link" href="@($"projects/read/{Project.Id}")">
            @Project.Title
            <img src="@filePath" class="card-img-bottom" />
        </NavLink>
    </div>
}

@code {
    [Parameter]
    public Project? Project { get; set; }

    private string? filePath;

    protected override async Task OnInitializedAsync()
    {
        if (Project != null)
        {
            if (Project.PicturePath != null)
            {
                filePath = await _fileModelService.GetFilePathWithVersionAsync(Project.PicturePath);
            }
        }
    }
}
