@page "/editpost/{id:int}"
@inject IPaaPindenAPIService PaaPindenAPI
@inject NavigationManager NavigationManager
<h3>EditPost</h3>

<EditForm Model="KnittingPostDTO" FormName="FormKnittingPost" OnValidSubmit="Submit" method="put" enctype="multipart/form-data">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <InputNumber @bind-Value="knittingPost.Id" hidden></InputNumber>
    <InputDate @bind-Value="knittingPost.TimeStamp" hidden></InputDate>
    <InputText @bind-Value="knittingPost.Author" hidden></InputText>


    <div class="mb-3">
        <div class="col-2">
            <label class="col-form-label">Title</label>
        </div>
        <div class="col-6">
            <InputText @bind-Value="KnittingPostDTO.Title" placeholder="KnittingPostDTO.Title" class="form-control"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="() => KnittingPostDTO.Title"></ValidationMessage>
        </div>

        <div class="col-2">
            <label class="col-form-label">Indhold</label>
        </div>
        <div class="col-6">
            <InputFile name="knittingPost.ImageFile" accept="image/*" class="form-control" />
        </div>
        <div class="col-6">
            <InputText @bind-Value="KnittingPostDTO.KnittingPostContent.Text" placeholder="KnittingPostDTO.KnittingPostContent.Text"
            class="form-control"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="() => KnittingPostDTO.KnittingPostContent.Text"></ValidationMessage>
        </div>
        <br />
        <button class="btn btn-primary" type="submit">Save</button>
        &nbsp;
        <a href="/" class="btn btn-primary">Cancel</a>
    </div>
</EditForm>



@code {
    [Parameter]
    public int id { get; set; }

    [SupplyParameterFromForm(FormName = "FormKnittingPost")]
    private KnittingPostDTO KnittingPostDTO { get; set; }

    private KnittingPost knittingPost = new();


    protected override async Task OnParametersSetAsync()
    {
        knittingPost ??= await PaaPindenAPI.GetKnittingPostAsync(id);

        if (knittingPost != null)
        {
            KnittingPostDTO = new KnittingPostDTO
            {
                Id = knittingPost.Id,
                Title = knittingPost.Title,
                TimeStamp = knittingPost.TimeStamp,
                Author = knittingPost.Author,
                KnittingPostContent = new Content
            {
                 Text = knittingPost.KnittingPostContent.Text
                // Pictures = new List<ContentPicture>()
                // {
                //     new ContentPicture
                //     {
                //         Path = knittingPost.KnittingPostContent.Pictures[0].Path
                //     }
                // },
                // Videos = new List<ContentVideo>()
                //     {
                //         new ContentVideo
                //         {
                //             Path = knittingPost.KnittingPostContent.Videos[0].Path
                //         }
                //     }
            }

            };
        }


    }

    private async Task Submit()
    {
        await PaaPindenAPI.UpdateKnittingPostAsync(KnittingPostDTO);
        NavigationManager.NavigateTo("/");
    }

}
