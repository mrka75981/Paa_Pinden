@page "/createpost"
@inject IPaaPindenAPIService PaaPindenAPI

<h3>Create a KnittingPost</h3>

<EditForm Model="knittingPost" FormName="formServer" OnValidSubmit="Submit">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <InputNumber @bind-Value="knittingPost.Id" hidden></InputNumber>
    <InputDate @bind-Value="knittingPost.TimeStamp" hidden></InputDate>
    <InputText @bind-Value="knittingPost.Author" hidden></InputText>

    <div class="mb-3">
        <div class="col-2">
            <label class="col-form-label">Title</label>
        </div>
        <div class="col-6">
            <InputText @bind-Value="knittingPost.Title" class="form-control"></InputText>
        </div> 
        <div class="col">
            <ValidationMessage For="() => knittingPost.Title"></ValidationMessage>
        </div> 

        <div class="col-2">
            <label class="col-form-label">Indhold</label>
        </div>
        <div class="col-6">
            <InputFile @bind-Value="knittingPost.KnittingPostContent.Pictures" class="form-control"></InputFile>
            <InputText @bind-Value="knittingPost.KnittingPostContent.Text" class="form-control"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="() => knittingPost.KnittingPostContent"></ValidationMessage>
        </div>
        <br />
        <button class="btn btn-primary" type="submit">Post</button>
        &nbsp;
        <a href="/" class="btn btn-primary">Close</a>
    </div>
</EditForm> 
<!-- Currently only able to add one picture InputFile hence the first element is binded here -->
<!-- For files we should use IFormFile but this could lead to issues with the dbcontext -->
<PaaPindenBlazor.NonRouteableComponents.ContentPicturePreview>

</PaaPindenBlazor.NonRouteableComponents.ContentPicturePreview>

@code {
    private KnittingPostDTO knittingPost { get; set; } = new KnittingPostDTO()
        {
            KnittingPostContent = new()
            {
                Pictures = new(),
                Videos = new()
            }

        };
    private async Task Submit()
    {
        await PaaPindenAPI.CreateKnittingPost(knittingPost);
    }
}
