@page "/createpost"
@using PaaPindenBlazor.NonRouteableComponents
@inject IPaaPindenAPIService PaaPindenAPI


<h3>Create a KnittingPost</h3>

<EditForm Model="knittingPost" FormName="FormKnittingPost" OnValidSubmit="Submit">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <InputNumber @bind-Value="knittingPost.Id" hidden></InputNumber>
    <InputDate @bind-Value="knittingPost.TimeStamp" hidden></InputDate>
    <InputText @bind-Value="knittingPost.Author" hidden></InputText>


    <div class="mb-3">
        <div class="col-2">
            <label class="col-form-label">Title</label>
        </div>
        <div class="col-6">
            <InputText @bind-Value="knittingPost.Title" class="form-control"></InputText>
        </div> 
        <div class="col">
            <ValidationMessage For="() => knittingPost.Title"></ValidationMessage>
        </div> 

        <div class="col-2">
            <label class="col-form-label">Indhold</label>
        </div>
        <div class="col-6">
            <ContentPictureUpload @ref="contentPictureUpload" Filepath="@knittingPost.KnittingPostContent.Pictures[0].Path"></ContentPictureUpload>
        </div>
        <div class="col-6">
            <InputText @bind-Value="knittingPost.KnittingPostContent.Text" class="form-control"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="() => knittingPost.KnittingPostContent.Text"></ValidationMessage>
        </div> 
        <br />
        <button class="btn btn-primary" type="submit">Post</button>
        &nbsp;
        <a href="/" class="btn btn-primary">Close</a>
    </div>
</EditForm> 
<!-- Currently only able to add one picture InputFile hence the first element is binded here -->
<!-- For files we should use IFormFile but this could lead to issues with the dbcontext -->
<ContentPicturePreview>

</ContentPicturePreview>

@code {
    [SupplyParameterFromForm(FormName = "FormKnittingPost")]
    private KnittingPostDTO knittingPost { get; set; } = new KnittingPostDTO()
        {
            KnittingPostContent = new()
            {
                Pictures = new()
                {
                    new ContentPicture
                    {

                    }

                },
                Videos = new()
            }

        };
    private ContentPictureUpload contentPictureUpload = new();

    protected override void OnParametersSet()
    {
        contentPictureUpload.FileInput ??= new();
        knittingPost ??= new KnittingPostDTO();
        knittingPost.KnittingPostContent ??= new();
        knittingPost.KnittingPostContent.Pictures ??= new();
        knittingPost.KnittingPostContent.Videos ??= new();

        if (knittingPost.KnittingPostContent.Pictures.Count == 0)
        {
            knittingPost.KnittingPostContent.Pictures.Add(new ContentPicture());
        }
    }


    private async Task Submit()
    {
        await contentPictureUpload.UploadFile();
        await PaaPindenAPI.CreateKnittingPost(knittingPost);
    }
}
