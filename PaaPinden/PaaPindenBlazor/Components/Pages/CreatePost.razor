@page "/createpost"
@inject IPaaPindenAPIService PaaPindenAPI
@inject NavigationManager NavigationManager
@inject IFileModelService FileModelService


<h1 class="PindenFont text-center" style="margin: 15px; margin-top: 30px;"><b>Opret opslag</b></h1>

<EditForm Model="knittingPost" FormName="FormKnittingPost" OnValidSubmit="Submit" method="post" enctype="multipart/form-data">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <InputNumber @bind-Value="knittingPost.Id" hidden></InputNumber>
    <InputDate @bind-Value="knittingPost.TimeStamp" hidden></InputDate>
    <InputText @bind-Value="knittingPost.UserId" hidden></InputText>

    <form>
        <div class="form-group PindenFont" style="margin: auto; width: 500px;">
            <div class="col-2 d-flex">
                <label class="col-form-label">Titel</label>
            </div>

            <div>
                <InputText @bind-Value="knittingPost.Title" class="form-control"></InputText>
            </div>

            <div>
                <ValidationMessage For="() => knittingPost.Title"></ValidationMessage>
            </div>

            <div>
                <label class="col-form-label">Indhold</label>
            </div>

            <div>
                <InputText @bind-Value="knittingPost.KnittingPostContent.Text" class="form-control"></InputText>
            </div>

            <div>
                <ValidationMessage For="() => knittingPost.KnittingPostContent.Text"></ValidationMessage>
            </div>

            <div>
                <label class="col-form-label">Billede</label>
            </div>

            <div>
                <InputFile name="knittingPost.ImageFile" accept="image/*" class="form-control" />
            </div>

            <div>
                <ValidationMessage For="() => knittingPost.KnittingPostContent.Text"></ValidationMessage>
            </div>

            <br />

            <div style="margin-bottom: 50px">
                <button class="btn" type="submit" style="background-color: #e8aeb5; width: 100px;">Opret</button>
                <a href="/" class="btn btn-secondary"style="width: 60px;">Luk</a>
            </div>
        </div>
    </form>

</EditForm> 
<ContentPicturePreview>

</ContentPicturePreview>

@code {
    [SupplyParameterFromForm(FormName = "FormKnittingPost")]
    private KnittingPostCreateDTO knittingPost { get; set; }
    protected override void OnParametersSet()
    {
        knittingPost ??= new KnittingPostCreateDTO();
        knittingPost.KnittingPostContent ??= new();
        knittingPost.KnittingPostContent.Pictures ??= new();
        knittingPost.KnittingPostContent.Videos ??= new();

        if (knittingPost.KnittingPostContent.Pictures.Count == 0)
        {
            knittingPost.KnittingPostContent.Pictures.Add(new ContentPicture());
        }
    }


    private async Task Submit()
    {
        var filepath = await FileModelService.UploadFileAsync(knittingPost.ImageFile);
        knittingPost.KnittingPostContent.Pictures[0].Path = filepath;
        await PaaPindenAPI.CreateKnittingPostAsync(new KnittingPostDTO
        {
            Title = knittingPost.Title,
            TimeStamp = DateTime.Today,
            UserId = knittingPost.UserId,
            KnittingPostContent = new Content
            {
                Text = knittingPost.KnittingPostContent.Text,
                Pictures = new List<ContentPicture>()
                {
                    new ContentPicture
                    {
                        Path = filepath
                    }
                }, 
                Videos = new List<ContentVideo>()
                    {
                        new ContentVideo
                        {
                            Path = filepath
                        }
                    }
            }
            
        });
        NavigationManager.NavigateTo("/");
    }

}
