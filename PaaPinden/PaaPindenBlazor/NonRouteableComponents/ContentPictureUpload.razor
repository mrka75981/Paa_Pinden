@using Microsoft.AspNetCore.Components.Forms
@using PaaPindenBlazor.Services
<div>
    <InputFile OnChange="OnSelectedFile" class="form-control"></InputFile>
</div>



@code {
    public FileModelService FileInput { get; set; } = new();
    string resultmessage = "";

    private string? folderpath = "";
    [Parameter]
    public string? Filepath { get; set; } = "";

    private async Task OnSelectedFile(InputFileChangeEventArgs args)
    {
        FileInput.File = args.File;
    }


    public async Task<string> UploadFile()
    {
        try
        {
            if (FileInput.File is null)
            {
                throw new Exception("File not found");
            }
            folderpath = Path.Combine(AppContext.BaseDirectory,"KnittingPostPictures");
            Filepath = Path.Combine(folderpath, FileInput.File.Name);
            Directory.CreateDirectory(folderpath);
            await using var stream = new FileStream(Filepath, FileMode.Create);
            await FileInput.File.OpenReadStream().CopyToAsync(stream);
            resultmessage = "Upload Succesful!";
            return Filepath;
        }
        catch(Exception ex)
        {
            resultmessage = ex.Message;
        }

        return null;

    }
}
