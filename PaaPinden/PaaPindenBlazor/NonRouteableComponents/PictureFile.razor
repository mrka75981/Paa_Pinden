@using Microsoft.AspNetCore.Components.Forms
@using PaaPindenBlazor.Services
@inject IFileModelService FileModelService

<div>
    <InputFile OnChange="OnFileChange" class="form-control"></InputFile>
</div>



@code {

    private async Task OnFileChange(InputFileChangeEventArgs args)
    {
        await FileModelService.OnSelectedFile(args);
    }

    public async Task<string> UploadFile()
    {
        var requestfilepath = await FileModelService.UploadFile();

        return requestfilepath;

    }
}
